<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimens_5dp"
    android:layout_marginBottom="@dimen/dimens_5dp"
    android:background="@drawable/bg_round_16_white"
    android:gravity="center_vertical"
    android:minHeight="@dimen/dimens_52dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/dimens_12dp"
    android:paddingTop="@dimen/dimens_12dp"
    android:paddingEnd="@dimen/dimens_10dp"
    android:paddingBottom="@dimen/dimens_12dp">

    <TextView
        android:id="@+id/userItemId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dimens_10dp"
        android:layout_weight="1"
        android:textColor="#1C1C1E"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/userItemDelete"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimens_30dp"
        android:background="@drawable/bg_user_delete_btn"
        android:gravity="center"
        android:minWidth="@dimen/dimens_60dp"
        android:paddingStart="@dimen/dimens_10dp"
        android:paddingEnd="@dimen/dimens_10dp"
        android:text="@string/device_user_delete"
        android:textColor="#FF3B30"
        android:textSize="15sp" />

</LinearLayout>
